# digital-me 环境变量模板
# 用法： cp .env.example .env   然后填本机值
# 规则： .env 永不入仓（.gitignore 已覆盖）；真实 endpoint / 角色卡路径 / 任何密钥
#        只放 private 仓（Flycat43/digital-me-private）或本机。
# 本文件只能出现占位符，出现真实值会被 scripts/check_repo.py 的 secret-scan 拦下。

# ---------------------------------------------------------------- 推理
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=digital-me-local
# ollama = /api/chat + think:false（最干净） | openai = /v1 + reasoning_effort:none
LLM_API_STYLE=ollama
# 只对 openai 风格生效；缺了它 /v1 会整段跑思维链、可见文本为空
LLM_EXTRA_BODY={"reasoning_effort":"none"}
# 4096 实测 3.2GB / 冷启动 0.80s / 35 tok/s；40960 是 8.8GB，桌宠没必要
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=160
LLM_TEMPERATURE=0.6
LLM_KEEP_ALIVE=30m

# ---------------------------------------------------------------- 语音合成
TTS_ENDPOINT=http://127.0.0.1:9880
# 5~8 秒参考音频；真文件放 private 仓的 voice/ 下，这里只写相对路径
TTS_REF_AUDIO=./voice/ref.wav
TTS_REF_TEXT=

# ---------------------------------------------------------------- 语音识别（未接入）
ASR_ENDPOINT=
ASR_PROVIDER=none

# ---------------------------------------------------------------- 人格
# public 仓只有 example 卡；真卡指向 private 仓
CHARACTER_CARD=../config/character.example.yaml

# ---------------------------------------------------------------- 其它
# 端口只监听 127.0.0.1；不要改成 0.0.0.0，否则同一局域网可访问
PET_PORT=8765
LOG_LEVEL=info

# ---------------------------------------------------------------- CI 专用（不要填真值）
# 私有词表（真实姓名/单位等）以 repository secret 注入，格式： 词1,词2,词3
PII_EXTRA_TERMS=
